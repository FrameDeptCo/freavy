{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/connector.cjs",
    "build:exe": "node build-exe.mjs"
  },
  "dependencies": {
    "express": "4.21.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "24.7.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.24.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
